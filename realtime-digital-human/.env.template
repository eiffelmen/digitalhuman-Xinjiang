BASE_URL=
API_KEY=
MODEL_NAME=

IFLYTEK_SN=
IFLYTEK_APPID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=

GONGAN_API_USERNAME=
GONGAN_API_PWD_MD5=
GONGAN_ASR_STREAMING=1
GONGAN_ASR_READY_TIMEOUT=3.0
GONGAN_ASR_BUFFERED_PARTIALS=1
GONGAN_ASR_PARTIAL_INTERVAL=1.0
GONGAN_ASR_PARTIAL_MIN_BYTES=24000

# WebRTC/session cleanup tuning
MAX_ACTIVE_WEBRTC_SESSIONS=1
SESSION_WS_CLOSE_GRACE=5
WEBRTC_DISCONNECT_GRACE=10
WEBRTC_VIDEO_LAG_RESET_S=0.25
WEBRTC_AUDIO_QUEUE_MAX=24
WEBRTC_VIDEO_FPS=25
WEBRTC_RENDER_FPS=25
WEBRTC_VIDEO_QUEUE_MAX=16
WEBRTC_VIDEO_HIGH_WATERMARK=8
WEBRTC_VIDEO_KEEP_FRAMES=7
WEBRTC_VIDEO_BACKPRESSURE_FRAMES=8
WEBRTC_VIDEO_MAX_WIDTH=540
WEBRTC_VIDEO_MAX_HEIGHT=960
WEBRTC_RENDER_CACHE_SIZE=1024
WEBRTC_RENDER_PRELOAD=1
WEBRTC_CLEAR_TRACKS_ON_SPEECH=0
WEBRTC_VIDEO_TRIM_LEAD_S=0.20

# Lazy avatar image loading
LS_IMAGE_CACHE_SIZE=1200
LS_IMAGE_PREFETCH=32

# Runtime queue limits
ASR_INPUT_QUEUE_MAX=250
ASR_OUTPUT_QUEUE_MAX=250
TTS_TEXT_QUEUE_MAX=32

# Wav2Lip inference backend
# Use "pytorch" by default. Build the TensorRT engine first before switching to "tensorrt".
WAV2LIP_BACKEND=pytorch
WAV2LIP_ENGINE_PATH=./wav2lip256/wav2lip_server_fp16.engine
WAV2LIP_FAST_FIRST_FRAME=0
WAV2LIP_FIRST_BATCH_SIZE=4
WAV2LIP_SYNC_SPEECH_START_INDEX=1
WAV2LIP_SPEECH_START_BRIDGE_FRAMES=6
DIGITAL_HUMAN_BATCH_SIZE=4

# Gongan TTS PCM stream tuning
GONGAN_TTS_SOURCE_SAMPLE_RATE=16000
GONGAN_TTS_SEGMENT_TIMEOUT=20
GONGAN_TTS_MIN_SEGMENT_LEN=12
GONGAN_TTS_MAX_SEGMENT_LEN=80

# Performance timing logs
PERF_LOG_ENABLED=1

# Focused pipeline diagnostics log.
# Send this file when investigating slow response, incomplete TTS, or lip-sync issues.
PIPELINE_DIAG_LOG_ENABLED=1
PIPELINE_DIAG_LOG_PATH=./logs/pipeline_diagnostics.log
PIPELINE_DIAG_LOG_LEVEL=DEBUG
PIPELINE_DIAG_LOG_ROTATION=200 MB
PIPELINE_DIAG_LOG_RETENTION=7 days

# Diagnostics for long-running browser playback stalls
SERVER_METRICS_ENABLED=1
SERVER_METRICS_INTERVAL_S=10
CLIENT_METRICS_MAX_BYTES=120000
CLIENT_METRICS_MAX_TEXT=3000

# 后端服务器地址配置
# 部署到不同环境时，修改此值为对应的后端服务器 IP 或域名
# 复制此文件为 .env 并修改对应的值

BACKEND_HOST=127.0.0.1

# Browser-side diagnostics. Metrics are posted to backend /client_metrics
# and written into backend logs as [CLIENT_METRICS].
VITE_CLIENT_METRICS_ENABLED=1
VITE_CLIENT_METRICS_INTERVAL_MS=10000
VITE_CLIENT_METRICS_VERBOSE=0
VITE_AUDIO_STREAM_METRICS_INTERVAL_MS=10000
